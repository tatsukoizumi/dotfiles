#!/bin/bash
# ハブのタブから、notes の work-log タブの Claude に稼働の開始・終了のコマンド (/<root>-start・/<root>-end) を送る。
# <root> はこのタブの cwd の ~ 直下のフォルダ名。コマンドの無い root では送らない。
set -euo pipefail

NOTES_WS=${WORKLOG_WORKSPACE:-notes}
NOTES_TAB=${WORKLOG_TAB:-work-log}
COMMANDS_DIR=${WORKLOG_COMMANDS_DIR:-$HOME/notes/.claude/commands}
TIMEOUT=${WORKLOG_TIMEOUT:-180000}

die() { printf 'worklog: %s\n' "$1" >&2; exit "${2:-1}"; }

usage() {
  cat <<'EOF'
worklog — notes の work-log タブで稼働の開始・終了を記録する

  worklog start [今日やること]     /<root>-start を送る
  worklog end [今日やったこと]     /<root>-end を送る
  worklog root                     このタブの root を出す

<root> はこのタブの cwd の ~ 直下のフォルダ名（~/<root>/... ならその root）。
送り先は workspace「notes」のタブ「work-log」の agent（WORKLOG_WORKSPACE / WORKLOG_TAB で変えられる）。
EOF
}

[ "${HERDR_ENV:-}" = 1 ] || die 'Herdr の pane 内でのみ実行できる（HERDR_ENV=1 が必要）' 2
command -v herdr >/dev/null || die 'herdr が PATH にない' 2
command -v jq >/dev/null || die 'jq が PATH にない' 2

root_of_tab() {
  local cwd rel
  cwd=$(herdr pane get "${HERDR_PANE_ID:-}" 2>/dev/null | jq -r '.result.pane.cwd // ""')
  [ -n "$cwd" ] || die 'このタブの cwd を取れない' 3
  case "$cwd" in
    "$HOME"/*) rel=${cwd#"$HOME"/} ;;
    *) die "~ の下ではないタブでは使えない（cwd=${cwd}）" 3 ;;
  esac
  printf '%s\n' "${rel%%/*}"
}

worklog_pane() {
  local ws tab pane
  ws=$(herdr workspace list | jq -r --arg l "$NOTES_WS" '.result.workspaces[] | select(.label == $l) | .workspace_id' | head -1)
  [ -n "$ws" ] || die "workspace「${NOTES_WS}」が無い" 4
  tab=$(herdr tab list | jq -r --arg w "$ws" --arg l "$NOTES_TAB" '.result.tabs[] | select(.workspace_id == $w and .label == $l) | .tab_id' | head -1)
  [ -n "$tab" ] || die "workspace「${NOTES_WS}」にタブ「${NOTES_TAB}」が無い" 4
  pane=$(herdr agent list | jq -r --arg t "$tab" '.result.agents[] | select(.tab_id == $t) | .pane_id' | head -1)
  [ -n "$pane" ] || die "タブ「${NOTES_TAB}」に agent が居ない（Claude を起動してから使う）" 4
  printf '%s\n' "$pane"
}

action=${1:-}
[ $# -gt 0 ] && shift
case "$action" in
  start | end) ;;
  root) root_of_tab; exit 0 ;;
  -h | --help | help | '') usage; exit 0 ;;
  *) usage >&2; exit 1 ;;
esac

root=$(root_of_tab)
command_name="${root}-${action}"
[ -f "$COMMANDS_DIR/${command_name}.md" ] \
  || die "/${command_name} が無い（${COMMANDS_DIR}）。この root の稼働の記録は未設定" 5

pane=$(worklog_pane)
status=$(herdr agent get "$pane" | jq -r '.result.agent.agent_status // "unknown"')
[ "$status" != blocked ] || die "work-log の agent が承認待ち（blocked）。herdr agent read $pane で確認する" 6
# 前の作業の途中なら終わるのを待つ（入力が混ざらないように）
[ "$status" = idle ] || herdr agent wait "$pane" --until idle --timeout "$TIMEOUT" >/dev/null

text="/${command_name}"
[ $# -gt 0 ] && text="$text $*"
herdr agent prompt "$pane" "$text" --wait --until idle --until blocked --timeout "$TIMEOUT" >/dev/null \
  || die "work-log の agent が ${TIMEOUT}ms 以内に終わらない。herdr agent read $pane で確認する" 7

herdr agent read "$pane" --source recent --lines 15
