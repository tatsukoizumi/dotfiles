#!/bin/bash
# ハブの pane から、work-log と名付けた pane の Claude に稼働の開始・終了のコマンド (/<root>-start・/<root>-end) を送る。
# <root> はこの pane の cwd の ~ 直下のフォルダ名。コマンドの無い root では送らない。
set -euo pipefail

TARGET_LABEL=${WORKLOG_PANE_LABEL:-work-log}
COMMANDS_DIR=${WORKLOG_COMMANDS_DIR:-$HOME/notes/.claude/commands}
TIMEOUT=${WORKLOG_TIMEOUT:-180000}

die() { printf 'worklog: %s\n' "$1" >&2; exit "${2:-1}"; }

usage() {
  cat <<'EOF'
worklog — work-log の pane で稼働の開始・終了を記録する

  worklog start [今日やること]     /<root>-start を送る
  worklog end [今日やったこと]     /<root>-end を送る
  worklog root                     この pane の root を出す

<root> はこの pane の cwd の ~ 直下のフォルダ名（~/<root>/... ならその root）。
送り先はラベルが「work-log」の pane の agent（WORKLOG_PANE_LABEL で変えられる）。
EOF
}

[ "${HERDR_ENV:-}" = 1 ] || die 'Herdr の pane 内でのみ実行できる（HERDR_ENV=1 が必要）' 2
command -v herdr >/dev/null || die 'herdr が PATH にない' 2
command -v jq >/dev/null || die 'jq が PATH にない' 2

root_of_pane() {
  local cwd rel
  cwd=$(herdr pane get "${HERDR_PANE_ID:-}" 2>/dev/null | jq -r '.result.pane.cwd // ""')
  [ -n "$cwd" ] || die 'この pane の cwd を取れない' 3
  case "$cwd" in
    "$HOME"/*) rel=${cwd#"$HOME"/} ;;
    *) die "~ の下ではない pane では使えない（cwd=${cwd}）" 3 ;;
  esac
  printf '%s\n' "${rel%%/*}"
}

worklog_pane() {
  local pane
  pane=$(herdr pane list | jq -r --arg l "$TARGET_LABEL" '.result.panes[] | select(.label == $l and has("agent")) | .pane_id' | head -1)
  [ -n "$pane" ] || die "ラベル「${TARGET_LABEL}」の pane に agent が居ない（Claude を起動し herdr pane rename で名付けてから使う）" 4
  printf '%s\n' "$pane"
}

action=${1:-}
[ $# -gt 0 ] && shift
case "$action" in
  start | end) ;;
  root) root_of_pane; exit 0 ;;
  -h | --help | help | '') usage; exit 0 ;;
  *) usage >&2; exit 1 ;;
esac

root=$(root_of_pane)
command_name="${root}-${action}"
[ -f "$COMMANDS_DIR/${command_name}.md" ] \
  || die "/${command_name} が無い（${COMMANDS_DIR}）。この root の稼働の記録は未設定" 5

pane=$(worklog_pane)
status=$(herdr agent get "$pane" | jq -r '.result.agent.agent_status // "unknown"')
[ "$status" != blocked ] || die "work-log の agent が承認待ち（blocked）。herdr agent read $pane で確認する" 6
# 前の作業の途中なら終わるのを待つ（入力が混ざらないように）
[ "$status" = idle ] || herdr agent wait "$pane" --until idle --timeout "$TIMEOUT" >/dev/null

text="/${command_name}"
[ $# -gt 0 ] && text="$text $*"
herdr agent prompt "$pane" "$text" --wait --until idle --until blocked --timeout "$TIMEOUT" >/dev/null \
  || die "work-log の agent が ${TIMEOUT}ms 以内に終わらない。herdr agent read $pane で確認する" 7

herdr agent read "$pane" --source recent --lines 15
