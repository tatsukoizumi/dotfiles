#!/bin/bash
# Dispatch work from one hub agent to per-repository agents running in Herdr panes.
set -euo pipefail

STATE=${FLEET_STATE:-$HOME/.local/state/fleet}
HUB_WS=${FLEET_HUB_WORKSPACE:-entry}
ROOTS_CONF=${FLEET_ROOTS_CONF:-$HOME/.config/fleet/roots}
HUB_NAME=''
HUB_SCOPE=''
ANY_SCOPE=false
SHOW_ALL=false
KIND=${FLEET_KIND:-claude}
MODEL=${FLEET_MODEL:-}
CLOUD=false
CLOUD_DESC=
WAIT_TIMEOUT_DEFAULT=900000
START_TIMEOUT=120000

die() { printf 'fleet: %s\n' "$1" >&2; exit "${2:-1}"; }

require_herdr() {
  [ "${HERDR_ENV:-}" = 1 ] || die 'Herdr の pane 内でのみ実行できる（HERDR_ENV=1 が必要）' 2
  command -v herdr >/dev/null || die 'herdr が PATH にない' 2
  command -v jq >/dev/null || die 'jq が PATH にない' 2
}

# --- target index ---------------------------------------------------------

repo_paths() {
  local d
  for d in "$HOME"/*/ "$HOME"/*/*/; do
    [ -e "${d}.git" ] && printf '%s\n' "${d%/}"
  done
}

index() {
  local ws panes agents repos
  ws=$(herdr workspace list | jq -c '.result.workspaces')
  panes=$(herdr pane list | jq -c '.result.panes')
  agents=$(herdr agent list | jq -c '.result.agents')
  repos=$(repo_paths | jq -R . | jq -sc .)
  jq -n --argjson ws "$ws" --argjson panes "$panes" --argjson agents "$agents" \
        --argjson repos "$repos" --arg home "$HOME" --arg hubws "${HERDR_WORKSPACE_ID:-}" '
    def slugify:
      ascii_downcase | gsub("[^a-z0-9_-]+"; "-") | gsub("^-+|-+$"; "") | .[0:32] | gsub("-+$"; "");
    def rel($p): if $p == $home then "" elif ($p | startswith($home + "/")) then $p[($home|length)+1:] else $p end;

    ($panes | group_by(.workspace_id) | map({key: .[0].workspace_id, value: .}) | from_entries) as $pw
    | ($agents | group_by(.workspace_id) | map({key: .[0].workspace_id, value: .}) | from_entries) as $aw
    | ($ws | map(. + {path: (.worktree.checkout_path
                          // ($aw[.workspace_id] // [] | map(.cwd) | first)
                          // ($pw[.workspace_id] // [] | map(.cwd) | group_by(.) | max_by(length) | .[0]))})
           | map(select(.path != null))) as $ws2
    | ( ($ws2 | map({path, label, workspace_id, number, worktree: (.worktree != null),
                     repo_root: .worktree.repo_root}))
      + ($repos | map({path: ., label: null, workspace_id: null})) ) as $all
    | ($all | group_by(.path)
            | map(reduce .[] as $e ({}; . * ($e | with_entries(select(.value != null)))))
            | map(select(.path != null))) as $merged
    | ($merged | map(rel(.path) | split("/") | (last // "home")) | group_by(.)
               | map(select(length > 1) | .[0])) as $dupes
    | $merged
    | map(. as $t
        | (rel($t.path) | split("/")) as $seg
        | ($seg | last // "home") as $base
        | (if ($dupes | index($base)) and ($seg | length) > 1
           then (($seg[-2] + "-" + $base) | slugify) else ($base | slugify) end) as $s0
        | (if ($s0 | test("^[a-z]")) then $s0 else ("r-" + $s0)[0:32] end) as $slug
        | ($agents | map(select(.workspace_id == $t.workspace_id
                                and (.cwd == $t.path or .foreground_cwd == $t.path))) | first) as $a
        | $t + {
            slug: $slug,
            rel: (rel($t.path) | if . == "" then "~" else . end),
            root: ((rel($t.repo_root // $t.path) | split("/"))
                   | if length > 1 then .[0] else "" end),
            agent: (if $a then {name: ($a.name // null), kind: $a.agent, pane_id: $a.pane_id,
                                status: $a.agent_status, title: $a.terminal_title_stripped} else null end),
            active: ($t.workspace_id != null)
          })
    | map(select(.workspace_id != $hubws))
    | sort_by([(if .active then 0 else 1 end), .rel])'
}

resolve() {
  local q=$1 idx=$2 hit
  [ -n "$q" ] || die 'ターゲットを指定する' 2
  case "$q" in
    /*) q=$(cd "$q" 2>/dev/null && pwd -P) || die "パスが見つからない: $1" 2 ;;
    "~/"*) q=$(cd "$HOME/${q#\~/}" 2>/dev/null && pwd -P) || die "パスが見つからない: $1" 2 ;;
  esac
  hit=$(jq -c --arg q "$q" '
    (map(select(.path == $q or .slug == $q or .label == $q or .rel == $q))) as $exact
    | if ($exact | length) > 0 then $exact
      else (map(select((.slug | contains($q)) or ((.label // "") | ascii_downcase | contains($q | ascii_downcase))
                       or (.rel | ascii_downcase | contains($q | ascii_downcase))))) as $fuzzy
        | ($fuzzy | map(select(.active))) as $act
        | if ($fuzzy | length) > 1 and ($act | length) == 1 then $act else $fuzzy end
      end' <<<"$idx")
  case "$(jq 'length' <<<"$hit")" in
    0) die "ターゲットが見つからない: $1" 3 ;;
    1) jq -c '.[0]' <<<"$hit" ;;
    *) printf 'fleet: ターゲットが曖昧: %s\n' "$1" >&2
       jq -c '{ambiguous: map({slug, label, rel, active})}' <<<"$hit" >&2
       exit 3 ;;
  esac
}

profile_of() {
  local path=$1 ccd ghd
  if command -v direnv >/dev/null; then
    eval "$(direnv exec "$path" sh -c 'printf "ccd=%q ghd=%q" "${CLAUDE_CONFIG_DIR:-}" "${GH_CONFIG_DIR:-}"' 2>/dev/null || printf 'ccd= ghd=')"
  fi
  jq -nc --arg ccd "${ccd:-}" --arg ghd "${ghd:-}" \
    '{claude_config_dir: (if $ccd == "" then "default" else $ccd end),
      gh_config_dir: (if $ghd == "" then "default" else $ghd end)}'
}

# --- agent kind / model ---------------------------------------------------

model_flag() {
  case "$1" in
    gemini|qwen) printf -- '-m' ;;
    *) printf -- '--model' ;;
  esac
}

agent_name_for() {
  local slug=$1 kind=$2
  if [ "$kind" = claude ]; then printf '%s\n' "$slug"; else printf '%s\n' "${slug:0:26}-${kind}"; fi
}

# --- hub scope ------------------------------------------------------------

root_of() {
  local p=$1 r
  [ "$p" = "$HOME" ] && { printf '\n'; return; }
  case "$p" in "$HOME"/*) r=${p#"$HOME"/}; printf '%s\n' "${r%%/*}" ;; *) printf '\n' ;; esac
}

owner_of() {
  local r=$1 a b
  [ -n "$r" ] || { printf '\n'; return; }
  if [ -f "$ROOTS_CONF" ]; then
    while read -r a b; do
      case "$a" in ''|\#*) continue ;; esac
      [ "$a" = "$r" ] || continue
      printf '%s\n' "${b:-$r}"; return
    done < "$ROOTS_CONF"
  fi
  printf '%s\n' "$r"
}

owner_map() {
  if [ -f "$ROOTS_CONF" ]; then
    jq -Rn --rawfile conf "$ROOTS_CONF" \
      '$conf | split("\n") | map(select(test("^\\s*(#|$)") | not) | split(" +"; null))
       | map({key: .[0], value: (if (.[1] // "") == "" then .[0] else .[1] end)}) | from_entries'
  else printf '{}\n'; fi
}

strip_deco() {
  jq -rn --arg s "$1" '$s | gsub("[\\p{So}\\p{Sk}\\p{Z}\\x{FE0F}\\x{200D}]"; "")'
}

require_hub() {
  local wslabel cwd
  wslabel=$(herdr workspace get "${HERDR_WORKSPACE_ID:-}" 2>/dev/null | jq -r '.result.workspace.label // ""')
  # workspace_id は herdr の再起動で振り直されるのでラベルで判定する。📌 などの飾りは無視する
  [ "$(strip_deco "$wslabel")" = "$(strip_deco "$HUB_WS")" ] \
    || die "ここはハブではない（workspace=${wslabel:-不明}）。fleet は $HUB_WS workspace のハブ pane から使う" 8
  local pane
  pane=$(herdr pane get "${HERDR_PANE_ID:-}" 2>/dev/null | jq -c '.result.pane // {}')
  cwd=$(jq -r '.cwd // ""' <<<"$pane")
  # entry には notes などハブでない agent も並ぶ。ハブは git リポジトリの外で動く
  ! git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1 \
    || die "ここはハブではない（cwd=${cwd} は git リポジトリ）" 8
  HUB_NAME=$(jq -r '.label // ""' <<<"$pane")
  HUB_SCOPE=$(owner_of "$(root_of "$cwd")")
}

hub_roots() {
  herdr agent list \
    | jq -r --arg ws "${HERDR_WORKSPACE_ID:-}" '.result.agents[] | select(.workspace_id == $ws) | .cwd' \
    | while read -r c; do
        git -C "$c" rev-parse --git-dir >/dev/null 2>&1 || owner_of "$(root_of "$c")"
      done | sort -u | grep -v '^$' || true
}

in_scope() {
  local owner; owner=$(owner_of "$1")
  if [ -n "$HUB_SCOPE" ]; then [ "$owner" = "$HUB_SCOPE" ]; return; fi
  [ -n "$owner" ] || return 0
  ! hub_roots | grep -qxF "$owner"
}

scope_hint() {
  local owner; owner=$(owner_of "$1")
  if [ -n "$owner" ] && hub_roots | grep -qxF "$owner"; then
    printf '%s のハブ' "$owner"
  else
    printf '個人ハブ（cwd が ~ の pane）'
  fi
}

scope_filter() {
  local claimed map
  if [ "$SHOW_ALL" = true ]; then cat; return; fi
  claimed=$(hub_roots | jq -R . | jq -sc .)
  map=$(owner_map)
  jq -c --arg scope "$HUB_SCOPE" --argjson claimed "$claimed" --argjson map "$map" \
    'map(select(. as $e | ($map[$e.root] // $e.root) as $o
                | if $scope != "" then $o == $scope
                  else ($o == "" or ($claimed | index($o) | not)) end))'
}

scope_cmd() {
  jq -nc --arg tab "$HUB_NAME" --arg scope "$HUB_SCOPE" \
         --argjson claimed "$(hub_roots | jq -R . | jq -sc .)" \
         --argjson map "$(owner_map)" \
         --argjson targets "$(index | scope_filter | jq 'length')" \
    '{hub: $tab,
      scope: (if $scope == "" then "個人（他のハブが持たない root すべて）" else $scope end),
      hub_roots: $claimed, root_aliases: $map, targets_in_scope: $targets}'
}

# --- ensure ---------------------------------------------------------------

free_shell_pane() {
  local ws=$1 pid
  for pid in $(herdr pane list --workspace "$ws" | jq -r '.result.panes[] | select(has("agent") | not) | .pane_id'); do
    if herdr pane process-info --pane "$pid" \
      | jq -e '.result.process_info
               | (.foreground_processes | length) == 1
               and (.foreground_processes[0].pid == .shell_pid)' >/dev/null 2>&1; then
      printf '%s\n' "$pid"; return 0
    fi
  done
  return 1
}

unique_agent_name() {
  local want=$1 pane=$2 taken n=2
  taken=$(herdr agent list | jq -r --arg p "$pane" '.result.agents[] | select(.pane_id != $p) | .name // empty')
  local name=$want
  while grep -qxF "$name" <<<"$taken"; do name="${want:0:29}-$n"; n=$((n+1)); done
  printf '%s\n' "$name"
}

ensure() {
  local target=$1 branch=${2:-} idx t path label slug ws pane name created=false
  idx=$(index) || exit $?
  t=$(resolve "$target" "$idx") || exit $?
  [ -n "$t" ] || die "ターゲットを解決できなかった: $target" 3
  path=$(jq -r .path <<<"$t"); slug=$(jq -r .slug <<<"$t")
  label=$(jq -r '.label // .rel' <<<"$t"); ws=$(jq -r '.workspace_id // empty' <<<"$t")
  command -v "$KIND" >/dev/null \
    || die "agent kind '${KIND}' の実行ファイルが PATH に無い。herdr integration status で導入状況を見る" 9
  [ -z "$ws" ] || [ "$ws" != "${HERDR_WORKSPACE_ID:-}" ] \
    || die "自分自身（ハブの workspace）はターゲットにできない: $slug" 2
  local troot; troot=$(jq -r .root <<<"$t")
  [ "$ANY_SCOPE" = true ] || in_scope "$troot" \
    || die "このハブ（${HUB_NAME:-個人}）の担当外: ${slug}（root=${troot:-~}）。$(scope_hint "$troot")から投げる" 8

  if [ -z "$ws" ]; then
    local res
    [ -d "$path" ] || die "作業ディレクトリが存在しない: $path" 3
    res=$(herdr workspace create --cwd "$path" --label "$(jq -r .rel <<<"$t")" --no-focus)
    ws=$(jq -r '.result.workspace.workspace_id' <<<"$res")
    pane=$(jq -r '.result.root_pane.pane_id' <<<"$res")
    label=$(jq -r .rel <<<"$t"); created=true
    mkdir -p "$STATE/owned"; : >"$STATE/owned/$ws"
  fi

  if [ -n "$branch" ]; then
    local blabel bslug wtres
    blabel="$label#$branch"
    bslug=$(printf '%s--%s' "${slug:0:16}" "$branch" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_-]\{1,\}/-/g; s/-\{1,\}$//' | cut -c1-32)
    local existing
    existing=$(herdr workspace list | jq -r --arg l "$blabel" '.result.workspaces[] | select(.label == $l) | .workspace_id' | head -1)
    if [ -n "$existing" ]; then
      ws=$existing
    else
      # 何も指定しないと元リポジトリの今の HEAD から切られるので、最新のデフォルトブランチを起点にする
      local base=()
      if git -C "$path" fetch -q origin 2>/dev/null; then
        local def
        def=$(git -C "$path" symbolic-ref -q --short refs/remotes/origin/HEAD \
          || { git -C "$path" remote set-head origin -a >/dev/null 2>&1 && git -C "$path" symbolic-ref -q --short refs/remotes/origin/HEAD; } || true)
        [ -n "$def" ] && ! git -C "$path" show-ref -q --verify "refs/heads/$branch" && base=(--base "$def")
      fi
      wtres=$(herdr worktree create --workspace "$ws" --branch "$branch" ${base[@]+"${base[@]}"} --label "$blabel" --no-focus)
      ws=$(jq -r '[.result | .. | objects | select(has("workspace_id")) | .workspace_id] | first' <<<"$wtres")
      [ -n "$ws" ] && [ "$ws" != null ] || die "worktree 作成の応答を解釈できない: $wtres"
      path=$(jq -r '[.result | .. | objects | .checkout_path? // empty] | first // empty' <<<"$wtres")
      [ -n "$path" ] || path=$(herdr pane list --workspace "$ws" | jq -r '.result.panes[0].cwd')
      mkdir -p "$STATE/owned"; : >"$STATE/owned/$ws"; created=true
    fi
    slug=$bslug; label=$blabel
  fi

  slug=$(agent_name_for "$slug" "$KIND")
  local existing_agent
  existing_agent=$(herdr agent list \
    | jq -c --arg ws "$ws" --arg kind "$KIND" \
        '[.result.agents[] | select(.workspace_id == $ws and .agent == $kind)] | first // empty')

  if [ -n "$existing_agent" ]; then
    pane=$(jq -r .pane_id <<<"$existing_agent")
    name=$(jq -r '.name // ""' <<<"$existing_agent")
    if [ "$name" != "$slug" ]; then
      name=$(unique_agent_name "$slug" "$pane")
      herdr agent rename "$pane" "$name" >/dev/null
    fi
  else
    [ -n "${pane:-}" ] || pane=$(free_shell_pane "$ws") || {
      pane=$(herdr pane split --pane "$(herdr pane list --workspace "$ws" | jq -r '.result.panes[0].pane_id')" \
              --direction right --cwd "$path" --no-focus | jq -r '.result.pane.pane_id')
      sleep 1
    }
    name=$(unique_agent_name "$slug" "$pane")
    local -a start_args=(--kind "$KIND" --pane "$pane" --timeout "$START_TIMEOUT")
    [ -z "$MODEL" ] || start_args+=(-- "$(model_flag "$KIND")" "$MODEL")
    if ! herdr agent start "$name" "${start_args[@]}" >/dev/null; then
      herdr agent get "$name" >/dev/null 2>&1 \
        || die "agent 起動に失敗した（pane=${pane}）。herdr pane read $pane で確認する" 5
    fi
  fi

  jq -nc --arg slug "$slug" --arg name "$name" --arg label "$label" --arg path "$path" \
         --arg ws "$ws" --arg pane "$pane" --argjson created "$created" \
         --arg kind "$KIND" --arg model "$MODEL" \
         --argjson profile "$(profile_of "$path")" \
         --arg status "$(herdr agent get "$name" 2>/dev/null | jq -r '.result.agent.agent_status // "unknown"' || echo unknown)" \
    '{slug: $slug, agent: $name, label: $label, path: $path, workspace_id: $ws, pane_id: $pane,
      created: $created, status: $status, kind: $kind,
      model: (if $model == "" then null else $model end), profile: $profile}'
}

# --- cloud ----------------------------------------------------------------

# claude --cloud はセッションを作って即終了する。pane には residents しないので
# herdr の agent にはならない。依頼本文は呼び出し側がセッションへ直接送る。
# --teleport は使わない（ローカルの作業ツリーのブランチを切り替えてしまう）。
cloud_cmd() {
  local target=$1 desc=$2 idx t path slug out sid url name
  idx=$(index) || exit $?
  t=$(resolve "$target" "$idx") || exit $?
  path=$(jq -r .path <<<"$t"); slug=$(jq -r .slug <<<"$t")
  local troot; troot=$(jq -r .root <<<"$t")
  [ "$ANY_SCOPE" = true ] || in_scope "$troot" \
    || die "このハブ（${HUB_NAME:-個人}）の担当外: ${slug}。$(scope_hint "$troot")から投げる" 8
  command -v claude >/dev/null || die "claude が PATH に無い" 9
  git -C "$path" remote get-url origin >/dev/null 2>&1 \
    || die "クラウド実行はリモートからクローンするため origin が必要: ${path}" 10
  [ -z "$(git -C "$path" status --porcelain 2>/dev/null)" ] \
    || printf 'fleet: 警告 %s に未コミットの変更がある。クラウド側のクローンには反映されない\n' "$path" >&2
  [ -n "$desc" ] || desc="$slug"

  local -a args=(--cloud "$desc")
  [ -z "$MODEL" ] || args+=(--model "$MODEL")
  # claude --cloud は TTY を要求するので pty を割り当てて実行する
  out=$(cd "$path" && script -q /dev/null claude "${args[@]}" 2>&1 \
        | tr -d '\r' | sed -E $'s/\x1b\\[[0-9;?>]*[a-zA-Z]//g; s/[\x01-\x08\x0b\x0c\x0e-\x1f]//g') \
    || die "クラウドセッションの作成に失敗した: $(head -2 <<<"$out")" 11
  grep -q 'Created cloud session' <<<"$out" \
    || die "クラウドセッションが作られなかった: $(grep -v '^$' <<<"$out" | head -3)" 11
  sid=$(grep -oE 'session_[A-Za-z0-9]+' <<<"$out" | head -1)
  url=$(grep -oE 'https://claude\.ai/code/[^ ?]+' <<<"$out" | head -1)
  name=$(sed -n 's/.*Created cloud session: //p' <<<"$out" | head -1)
  [ -n "$sid" ] || die "セッション ID を読み取れなかった: $(head -3 <<<"$out")" 11

  mkdir -p "$STATE/dispatch"
  jq -nc --arg slug "$slug" --arg path "$path" --arg sid "$sid" --arg url "$url" \
         --arg name "$name" --arg model "$MODEL" --arg desc "$desc" \
         --arg sent "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg contract "$(cloud_contract)" \
    '{slug: $slug, cloud: true, path: $path, session_id: $sid, url: $url,
      session_name: $name, model: (if $model == "" then null else $model end),
      description: $desc, sent_at: $sent, contract: $contract}' \
    | tee "$STATE/dispatch/${slug}.cloud.json"
}

# --- send -----------------------------------------------------------------

cloud_contract() {
  cat <<EOF

---
[fleet / 代表エージェントからの依頼（クラウド実行）]
- 作業はクラウド上のクローンで行われる。ローカルのファイルには書けない
- 完了したら変更をブランチに積み、PR を作って報告を PR 本文に書く。チャットへの最終応答は PR の URL だけにする
- PR 本文には「やったこと / 変更の要点 / 品質ゲートの結果 / 残課題」を書く。差分の全列挙はしない
- クラウド実行では PR が成果の受け渡し手段なので、push と PR 作成は許可されている
- 判断を要して進められないときは PR を作らず、「要確認」として質問をチャットに1行で書いて止まる
EOF
}

contract() {
  cat <<EOF

---
[fleet / 代表エージェントからの依頼]
- 作業ディレクトリ: $2
- 完了したら作業結果を Markdown で $1 に書き、チャットへの最終応答はそのファイルパスだけにする
- report には「やったこと / 変更の要点 / 品質ゲートの結果 / 残課題」を書く。差分の全列挙はしない
- 実装とコミットまでは自律的に進めてよい。push と PR 作成は、リポジトリの規約（CLAUDE.md 等）か依頼本文が許すときだけ行い、どちらにも定めが無ければしない。外部サービスへの変更（デプロイ・マージなど）はしない。必要なら report に「要指示」として書く
- 判断を要して進められないときは report に「要確認」として質問を書いてから止まる
EOF
}

send() {
  local target=$1 prompt=$2 wait=$3 timeout=$4 branch=$5 fresh=$6 info slug path report ts
  info=$(ensure "$target" "$branch") || exit $?
  [ -n "$info" ] || die "ターゲットの準備に失敗した: $target" 5
  slug=$(jq -r .agent <<<"$info"); path=$(jq -r .path <<<"$info")
  [ "$(jq -r .status <<<"$info")" != blocked ] \
    || die "agent が承認待ち（blocked）で投入できない: ${slug}。herdr agent read $slug で確認し、人の判断を仰ぐ" 4

  if [ "$fresh" = true ] && [ "$(jq -r .created <<<"$info")" = false ]; then
    [ "$KIND" = claude ] || die "--fresh は claude の agent だけに使える: ${slug}" 2
    # 作業中に /clear を送ると、進行中のタスクの文脈を捨ててしまう。
    [ "$(jq -r .status <<<"$info")" = idle ] \
      || die "agent が待機中でないので --fresh で始め直せない: ${slug}。fleet status で終わるのを待つ" 4
    herdr agent prompt "$slug" "/clear" >/dev/null
    herdr agent wait "$slug" --timeout 30000 >/dev/null 2>&1 || true
  fi

  if [ -n "$MODEL" ] && [ "$(jq -r .created <<<"$info")" = false ]; then
    if [ "$KIND" = claude ]; then
      herdr agent prompt "$slug" "/model ${MODEL}" >/dev/null
      herdr agent wait "$slug" --timeout 30000 >/dev/null 2>&1 || true
    else
      printf 'fleet: 起動済みの %s agent にはモデルを切り替えられない。現状のまま投入する\n' "$KIND" >&2
    fi
  fi

  ts=$(date -u +%Y%m%dT%H%M%SZ)
  mkdir -p "$STATE/dispatch"

  local full
  if [ "$CLOUD" = true ]; then
    report=''
    full="$prompt$(cloud_contract)"
  else
    report="$STATE/reports/$(jq -r .slug <<<"$info")/$ts.md"
    mkdir -p "$(dirname "$report")"
    full="$prompt$(contract "$report" "$path")"
  fi
  if [ "$wait" = true ]; then
    herdr agent prompt "$slug" "$full" --wait --timeout "$timeout" >/dev/null
  else
    herdr agent prompt "$slug" "$full" >/dev/null
  fi

  jq -c --arg report "$report" --arg sent "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg prompt "$prompt" \
    '. + {report: (if $report == "" then null else $report end), sent_at: $sent, prompt: $prompt}' <<<"$info" \
    | tee "$STATE/dispatch/$(jq -r .slug <<<"$info").json"
}

# --- status / report ------------------------------------------------------

status() {
  local idx targets dispatch='{}' slug f rep exists mtime read_flag
  idx=$(index) || exit $?
  if [ -n "${1:-}" ]; then targets="[$(resolve "$1" "$idx" || exit $?)]"
  else targets=$(jq -c --arg hub "${HERDR_WORKSPACE_ID:-}" \
    'map(select(.active and .agent != null and .workspace_id != $hub))' <<<"$idx" | scope_filter); fi

  for slug in $(jq -r '.[].slug' <<<"$targets"); do
    f="$STATE/dispatch/$slug.json"
    [ -f "$f" ] || continue
    rep=$(jq -r '.report // ""' "$f")
    if [ -n "$rep" ] && [ -f "$rep" ]; then
      exists=true; mtime=$(date -u -r "$rep" +%Y-%m-%dT%H:%M:%SZ)
    else exists=false; mtime=''; fi
    if [ "$exists" = true ] && [ "$(cat "$STATE/dispatch/$slug.read" 2>/dev/null)" = "$rep" ]; then
      read_flag=true; else read_flag=false; fi
    dispatch=$(jq -c --arg s "$slug" --argjson d "$(jq -c '{sent_at, report, kind, model, prompt: .prompt[0:120]}' "$f")" \
      --argjson exists "$exists" --argjson rd "$read_flag" --arg mtime "$mtime" \
      '.[$s] = ($d + {report_exists: $exists, read: $rd,
                      report_at: (if $mtime == "" then null else $mtime end)})' <<<"$dispatch")
  done

  jq -c --argjson disp "$dispatch" '
    map({slug, agent: .agent.name, label, rel, workspace_id, pane_id: .agent.pane_id,
         status: .agent.status, title: .agent.title, dispatch: ($disp[.slug] // null)})
    | {agents: .,
       blocked: [.[] | select(.status == "blocked") | .slug],
       awaiting_report: [.[] | select(.dispatch != null and (.dispatch.report_exists | not)) | .slug],
       reports_unread: [.[] | select(.dispatch.report_exists == true and .dispatch.read == false) | .slug],
       counts: (group_by(.status) | map({key: .[0].status, value: length}) | from_entries)}' <<<"$targets"
}

report_cmd() {
  local target=$1 list=$2 idx t dir latest
  idx=$(index) || exit $?
  t=$(resolve "$target" "$idx") || exit $?
  local dslug; dslug=$(jq -r .slug <<<"$t")
  if [ -f "$STATE/dispatch/${dslug}.cloud.json" ] && [ ! -d "$STATE/reports/${dslug}" ]; then
    jq -r '"クラウド実行の依頼なので report ファイルは無い。\nセッション: \(.session_name) \(.url)\n成果は PR で返る: gh pr list"' \
      "$STATE/dispatch/${dslug}.cloud.json" >&2
    exit 6
  fi
  dir="$STATE/reports/${dslug}"
  [ -d "$dir" ] || die "report がまだない: ${dslug}" 6
  if [ "$list" = true ]; then ls -1t "$dir"; return; fi
  latest=$(ls -1t "$dir" | head -1)
  [ -n "$latest" ] || die "report がまだない: $(jq -r .slug <<<"$t")" 6
  printf '# %s\n\n' "$dir/$latest"; cat "$dir/$latest"
  mkdir -p "$STATE/dispatch"; printf '%s' "$dir/$latest" >"$STATE/dispatch/$(jq -r .slug <<<"$t").read"
}

close_cmd() {
  local target=$1 force=$2 idx t ws
  idx=$(index) || exit $?
  t=$(resolve "$target" "$idx") || exit $?
  ws=$(jq -r '.workspace_id // empty' <<<"$t")
  [ -n "$ws" ] || die "workspace がない: $(jq -r .slug <<<"$t")" 3
  if [ ! -f "$STATE/owned/$ws" ] && [ "$force" != true ]; then
    die "fleet が作った workspace ではない（${ws}）。閉じるならユーザーの明示指示を得て --force を付ける" 7
  fi
  if [ "$(jq -r '.worktree // false' <<<"$t")" = true ]; then
    herdr worktree remove --workspace "$ws"
  else
    herdr workspace close "$ws"
  fi
  rm -f "$STATE/owned/$ws"
}

usage() {
  cat <<'EOF'
fleet — Herdr 上の各リポジトリ agent にハブから作業を投げる

  fleet scope                          このハブの担当範囲を出す
  fleet cloud <target> [説明]           クラウドセッションを作る（依頼本文は別途送る）
  fleet targets [--all]                候補と現在の workspace/agent を JSON で出す
  fleet ensure <target> [opts]         workspace と agent を冪等に用意する
  fleet send <target> [opts]           報告契約付きでプロンプトを投入する
  fleet status [target] [--all]        agent の状態をまとめて出す
  fleet report <target> [--list]       最新 report を表示する
  fleet watch <target> [--timeout SEC] report が届くか承認待ちになるまで待つ（ハブはバックグラウンドで実行）
  fleet close <target> [--force]       fleet が作った workspace を閉じる

ensure / send のオプション:
  --prompt TEXT | --prompt-file PATH | -   プロンプト本文（send のみ。- は標準入力）
  --wait [--timeout MS]                    完了まで待つ（既定は非同期。send のみ）
  --fresh                                  起動済みの agent に /clear してから送る（別タスクの依頼。send のみ）
  --branch B                               worktree workspace で作業する
  --kind K                                 agent の種類（既定 claude。herdr agent で一覧）
  --model M                                モデル（claude なら fable / opus / sonnet / haiku 等）

target は slug / workspace ラベル / ~ からの相対パス / 絶対パスで指定する。

ハブは entry workspace に置いた Claude の pane。担当範囲はその pane の cwd で決まり、
~/<root> なら その root 専用、~ なら他のハブが持たない root すべてになる。
~/.config/fleet/roots で、別の場所にあるルートを同じハブに寄せられる。
--all は一覧の範囲外も表示する。--any-scope は投入の範囲チェックを外す（原則使わない）。
既定は FLEET_KIND / FLEET_MODEL で変えられる。claude 以外の kind は agent 名が <slug>-<kind> になる。
fleet cloud はセッションを作るだけ。claude --cloud は pane に残らないので、依頼本文は
作成後にセッションへ直接送る（出力の contract を本文に添える）。成果は PR で返る。
EOF
}

# --- watch -----------------------------------------------------------------

# 最新の依頼の report が届くか、agent が承認待ちになるまで待つ。
# ハブはこれをバックグラウンドで走らせ、終了の通知で回収する（send は非同期なので、待つ仕組みが無いと取りこぼす）
watch_cmd() {
  local target=$1 timeout=$2 s rep st deadline
  [ -n "$target" ] || die 'watch には target が要る' 2
  deadline=$(( $(date +%s) + timeout ))
  while :; do
    s=$(status "$target") || exit $?
    rep=$(jq -r '.agents[0].dispatch.report // ""' <<<"$s")
    st=$(jq -r '.agents[0].status // ""' <<<"$s")
    if [ "$st" = blocked ]; then
      printf 'blocked: %s が承認待ち・質問待ち。herdr agent read で確認してユーザーに判断を仰ぐ\n' "$target"
      exit 5
    fi
    if [ -n "$rep" ] && [ -f "$rep" ] && [ "$st" != working ]; then
      printf 'report: %s\n\n' "$rep"; cat "$rep"; return 0
    fi
    [ "$(date +%s)" -lt "$deadline" ] || { printf 'timeout: %s（status=%s）\n' "$target" "$st"; exit 6; }
    sleep 20
  done
}

main() {
  local cmd=${1:-help}; shift || true
  case "$cmd" in
    help|-h|--help) usage; return ;;
  esac
  require_herdr
  require_hub
  case "$cmd" in
    scope) scope_cmd ;;
    cloud)
      local target='' desc=''
      while [ $# -gt 0 ]; do
        case $1 in
          --model) MODEL=$2; shift 2 ;;
          --desc) desc=$2; shift 2 ;;
          --any-scope) ANY_SCOPE=true; shift ;;
          -*) die "不明なオプション: $1" 2 ;;
          *) if [ -z "$target" ]; then target=$1; else desc=$1; fi; shift ;;
        esac
      done
      cloud_cmd "$target" "$desc" ;;
    targets)
      while [ $# -gt 0 ]; do
        case $1 in --all) SHOW_ALL=true; shift ;; *) die "不明なオプション: $1" 2 ;; esac
      done
      index | scope_filter ;;
    ensure)
      local target='' branch=''
      while [ $# -gt 0 ]; do
        case $1 in
          --branch) branch=$2; shift 2 ;;
          --kind) KIND=$2; shift 2 ;;
          --model) MODEL=$2; shift 2 ;;
          --any-scope) ANY_SCOPE=true; shift ;;
          -*) die "不明なオプション: $1" 2 ;;
          *) target=$1; shift ;;
        esac
      done
      ensure "$target" "$branch" ;;
    send)
      local target='' prompt='' wait=false timeout=$WAIT_TIMEOUT_DEFAULT branch='' got=false fresh=false
      while [ $# -gt 0 ]; do
        case $1 in
          --fresh) fresh=true; shift ;;
          --prompt) prompt=$2; got=true; shift 2 ;;
          --prompt-file) prompt=$(cat "$2"); got=true; shift 2 ;;
          -) prompt=$(cat); got=true; shift ;;
          --wait) wait=true; shift ;;
          --timeout) timeout=$2; shift 2 ;;
          --branch) branch=$2; shift 2 ;;
          --kind) KIND=$2; shift 2 ;;
          --model) MODEL=$2; shift 2 ;;
          --any-scope) ANY_SCOPE=true; shift ;;
          -*) die "不明なオプション: $1" 2 ;;
          *) target=$1; shift ;;
        esac
      done
      [ "$got" = true ] && [ -n "$prompt" ] || die 'プロンプトを --prompt / --prompt-file / - で渡す' 2
      send "$target" "$prompt" "$wait" "$timeout" "$branch" "$fresh" ;;
    status)
      while [ $# -gt 0 ]; do
        case $1 in --all) SHOW_ALL=true; shift ;; -*) die "不明なオプション: $1" 2 ;; *) break ;; esac
      done
      status "${1:-}" ;;
    report)
      local target='' list=false
      while [ $# -gt 0 ]; do
        case $1 in --list) list=true; shift ;; -*) die "不明なオプション: $1" 2 ;; *) target=$1; shift ;; esac
      done
      report_cmd "$target" "$list" ;;
    watch)
      local target='' timeout=10800
      while [ $# -gt 0 ]; do
        case $1 in --timeout) timeout=$2; shift 2 ;; -*) die "不明なオプション: $1" 2 ;; *) target=$1; shift ;; esac
      done
      watch_cmd "$target" "$timeout" ;;
    close)
      local target='' force=false
      while [ $# -gt 0 ]; do
        case $1 in --force) force=true; shift ;; -*) die "不明なオプション: $1" 2 ;; *) target=$1; shift ;; esac
      done
      close_cmd "$target" "$force" ;;
    *) die "不明なサブコマンド: ${cmd}（fleet help）" 2 ;;
  esac
}

main "$@"
